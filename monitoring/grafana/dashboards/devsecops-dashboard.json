      "title": "INDICATEURS CLÉS DE SÉCURITÉ RUNTIME & ZERO TRUST",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Processus Bloqués via eBPF (SIGKILL)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "sum(tetragon_policy_filter_actions_total{action=\"sigkill\"}) or vector(0)",
          "legendFormat": "SIGKILL"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Tentatives d'Admission Bloquées (Kyverno)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "targets": [
        {
          "expr": "sum(kyverno_admission_requests_total{rule_result=\"fail\"}) or vector(0)",
          "legendFormat": "Rejets Kyverno"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "purple", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Pods en Quarantaine Réseau Active",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "count(kube_pod_labels{label_security_status=\"quarantined\"}) or vector(0)",
          "legendFormat": "En Quarantaine"
        }
      ],
      "options": {
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Événements Noyau Tracés (Tetragon)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "expr": "sum(tetragon_events_total) or vector(0)",
          "legendFormat": "Total Events"
        }
      ],
      "options": {
        "colorMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "TÉLÉMÉTRIE TEMPS RÉEL & HISTORIQUE DES ATTAQUES",
      "type": "row"
    },
    {
      "id": 5,
      "title": "Activité eBPF Tetragon par type d'événement",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "sum by (type) (rate(tetragon_events_total[1m]))",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Violations de Politiques Kyverno par Règle",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "sum by (rule_name) (rate(kyverno_admission_requests_total{rule_result=\"fail\"}[1m]))",
          "legendFormat": "{{rule_name}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
